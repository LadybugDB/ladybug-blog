---
import config from "@config/config.json";
import HeartIcon from "@components/icons/HeartIcon.astro";
const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-screen-lg px-4 sm:px-6 lg:px-8">
  <div class="border-t border-gray-100 dark:border-gray-800">
    <p class="text-center text-xs/relaxed text-gray-500 dark:text-gray-400 mt-8 mb-8">
      Ladybugs are lovable insects.<br>
      &copy; {year} LadybugDB developers. All rights reserved.
    </p>
  </div>
</footer>
