---
import { Image } from "astro:assets";
import config from "@config/config.json";
import social from "@config/social";

const socialItems = social.networks;
---

<section class="bg-gray-50 dark:bg-gray-950">
  <div class="mx-auto max-w-screen-lg px-4 py-0 sm:px-4 pb-6 sm:pb-12 lg:px-4">
    <div class="flex items-start justify-between">
      <div class="rounded-lg w-full">
        <h1
          class="text-lg font-bold text-gray-900 dark:text-white sm:text-3xl mb-0"
        >
        {config.blog_description.heading}
        </h1>
        <p class="mt-1.5 text-sm md:text-lg text-gray-500 dark:text-gray-400">
          {config.blog_description.bio}
        </p>
        <div class="flex space-x-5 pt-8 m-auto">
          {
            socialItems?.map((item) => (
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-red-600 dark:text-gray-400 dark:hover:text-red-400 transition-colors">
                <figure>
                  <Fragment set:html={item.svg} />
                </figure>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
